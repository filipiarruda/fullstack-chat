# Docker Environment Variables
# This file is used by docker-compose to configure services

# ============================================
# Backend NestJS Configuration
# ============================================
BACKEND_NODE_ENV=production
BACKEND_PORT=3002

# Database
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=chat_db
DB_USER=chat_user
DB_PASSWORD=chat_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=3600

# API
API_URL=http://backend:3002
API_CORS_ORIGIN=http://frontend:3000

# ============================================
# Frontend Next.js Configuration
# ============================================
FRONTEND_NODE_ENV=production
FRONTEND_PORT=3000

# API URL (visible to client)
NEXT_PUBLIC_API_URL=http://backend:3002
NEXT_PUBLIC_WS_URL=ws://backend:3002

# ============================================
# MySQL Configuration
# ============================================
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=chat_db
MYSQL_USER=chat_user
MYSQL_PASSWORD=chat_password

# ============================================
# Docker Compose Configuration
# ============================================
COMPOSE_PROJECT_NAME=fullstack-chat
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
